# ---------------------------------------------------------------------------
# Backend configuration — copy to `.env` and fill in real values.
# NEVER commit the real `.env` (it is gitignored).
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
DB_NAME=finanalyzer
REDIS_URI=redis://localhost:6379

# Use a long, random secret in production, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Embeddings (RAG) ---
# "local"  = ChromaDB's built-in MiniLM, fully offline & free (default, recommended)
# "gemini" = Google embeddings (needs GOOGLE_API_KEY below, uses free-tier quota)
EMBED_PROVIDER=local

# Google AI Studio key. https://aistudio.google.com/apikey
# Only needed if EMBED_PROVIDER=gemini OR LLM_MODEL is a gemini/* chat model.
GOOGLE_API_KEY=your-gemini-api-key

# --- Chat LLM provider (env-swappable) ---
# Groq free tier is far more generous than Gemini's; recommended for demos.
# Get a key at https://console.groq.com/keys
LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key
# Alternatives:
#   LLM_MODEL=gemini/gemini-2.5-flash          # Google (free tier ~5 req/min)
#   LLM_MODEL=groq/openai/gpt-oss-120b         # Groq, OpenAI open-weight
#   LLM_MODEL=groq/moonshotai/kimi-k2-instruct # Groq, strong agentic/tool use

# --- Optional overrides ---
# LLM_TEMPERATURE=0.2
# EMBED_MODEL=models/gemini-embedding-001
# AGENT_MAX_RPM=15
# MAX_UPLOAD_BYTES=52428800
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Frontend configuration lives in finanalyzerUI/.env :
#   VITE_API_URL=http://localhost:8000
# ---------------------------------------------------------------------------
